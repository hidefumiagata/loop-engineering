{
  "$comment": "loop-engineering の中央設定。SKILL.md と loop/bin/*.mjs がこれを読む。cron の頻度を変えたら preset も見直す。",
  "version": 1,
  "preset": "hourly",
  "presets": {
    "pro": {
      "$comment": "run が少ない場合。1 run で複数フェーズを通し、前進量を最大化する",
      "granularity": "iteration",
      "issues_per_run": 1
    },
    "max": {
      "$comment": "run に余裕がある場合。1 run 1 フェーズにして記録を細かくし、巻き戻しを容易にする",
      "granularity": "phase",
      "issues_per_run": 2
    },
    "hourly": {
      "$comment": "毎時実行。run は潤沢なので律速はトークン枠。1 run を短く保つ。Max なら issues_per_run を 2 に上げてもよい",
      "granularity": "phase",
      "issues_per_run": 1
    }
  },
  "defaults": {
    "max_iterations": 5,
    "max_panel_rounds": 2,
    "base_branch": "main",
    "branch_prefix": "claude/loop-"
  },
  "providers": {
    "gemini": {
      "endpoint": "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
      "auth": {
        "header": "x-goog-api-key",
        "prefix": "",
        "local_env": "GEMINI_API_KEY"
      },
      "tiers": {
        "review": {
          "enabled": true,
          "model": "gemini-3.1-flash-lite",
          "price_per_mtok": {
            "in": 0.25,
            "out": 1.5
          },
          "max_output_tokens": 8000,
          "stream": true,
          "$comment": "stream: true で SSE にする。プロキシは最初のバイトを約30秒待って届かないと 502 を返す（総所要の制限ではない）ため、非ストリーミングだと全文を30秒以内に返しきる必要がある"
        },
        "propose": {
          "enabled": true,
          "model": "gemini-3.8-flash",
          "price_per_mtok": {
            "in": 0.75,
            "out": 3.75
          },
          "$comment": "2026-12-31 までの価格。2027-01-01 以降は in 1.50 / out 7.50 に変わるので要更新。プロキシは最初のバイトを約30秒待つだけなので、stream: true なら長い生成も通る（実測 59〜167秒の生成が成功）",
          "max_output_tokens": 16000,
          "stream": true
        }
      }
    },
    "openai": {
      "endpoint": "https://api.openai.com/v1/responses",
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer",
        "local_env": "OPENAI_API_KEY"
      },
      "tiers": {
        "review": {
          "enabled": false,
          "model": "gpt-5-mini",
          "price_per_mtok": {
            "in": 0.25,
            "out": 2
          },
          "max_output_tokens": 8000
        },
        "evaluate": {
          "enabled": true,
          "model": "gpt-5-mini",
          "price_per_mtok": {
            "in": 0.25,
            "out": 2
          },
          "reasoning_effort": "low",
          "max_output_tokens": 8000
        },
        "propose": {
          "enabled": true,
          "model": "gpt-5.5",
          "price_per_mtok": {
            "in": 5,
            "out": 30
          },
          "reasoning_effort": "high",
          "background": true,
          "$comment": "長い生成はプロキシの約30秒制限に当たるため background で非同期化する。非同期なので上限を上げてよい（8000 では gpt-5.5 が打ち切られた: Issue #10）",
          "max_output_tokens": 16000
        }
      }
    }
  },
  "usecases": {
    "research": {
      "mode": "pipeline",
      "label": "use:research",
      "deliverable": "report.md",
      "reviewer": "gemini:review",
      "planner_critic": "gemini:review",
      "require_human_decision": false
    },
    "build": {
      "mode": "pipeline",
      "label": "use:build",
      "deliverable": "src/",
      "reviewer": "gemini:review",
      "planner_critic": "gemini:review",
      "require_human_decision": false
    },
    "ideation": {
      "mode": "pipeline",
      "label": "use:ideation",
      "deliverable": "report.md",
      "reviewer": "gemini:review",
      "planner_critic": "gemini:review",
      "require_human_decision": false
    },
    "deliberation": {
      "mode": "panel",
      "label": "use:deliberation",
      "deliverable": "answer.md",
      "$comment": "1.3者が意見を出す 2.自分以外を敵対的レビュー 3.レビューを受けて改稿 4.Claudeの別エージェントが結論をまとめる",
      "proposers": [
        "claude",
        "gemini:propose",
        "openai:propose"
      ],
      "challengers": [
        "claude",
        "gemini:propose",
        "openai:propose"
      ],
      "revisers": [
        "claude",
        "gemini:propose",
        "openai:propose"
      ],
      "synthesizer": "subagent:panel-synthesizer",
      "planner_critic": "gemini:review",
      "min_proposers": 3,
      "require_human_decision": false
    }
  }
}
